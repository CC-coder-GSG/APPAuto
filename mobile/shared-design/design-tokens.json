      "onPrimaryContainer": "#1D4ED8"
    },
    "text": {
      "strong": "#0F172A",
      "default": "#1E293B",
      "muted": "#64748B",
      "disabled": "#94A3B8"
    },
    "surface": {
      "background": "#F8FAFC",
      "card": "#FFFFFF",
      "border": "#E2E8F0"
    },
    "status": {
