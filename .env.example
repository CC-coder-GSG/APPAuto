APP_ENV=dev
APP_SECRET_KEY=replace_with_a_strong_random_secret
APP_DATABASE_URL=sqlite:///./app_auto.db
APP_ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_WECOM_WEBHOOK_URL=
APP_SCHEDULER_TIMEZONE=Asia/Shanghai
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://192.168.2.148:81

# Zentao browser sync integration
APP_ZENTAO_SYNC_ENABLED=true
APP_ZENTAO_SYNC_API_KEY=change-me
APP_ZENTAO_SYNC_AUTO_MAP_TESTCASE=true
APP_ZENTAO_SYNC_AUTO_APPLY_TESTCASE=false
APP_ZENTAO_SYNC_AUTO_APPLY_BUG=false

# 兼容旧变量名（不推荐，建议统一 APP_ 前缀）
# ENV=dev
# SECRET_KEY=replace_with_a_strong_random_secret
# DATABASE_URL=sqlite:///./app_auto.db
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# WECHAT_WEBHOOK_URL=
# SCHEDULER_TIMEZONE=Asia/Shanghai
