APP_ENV=dev
APP_SECRET_KEY=replace_with_a_strong_random_secret
APP_DATABASE_URL=sqlite:///./app_auto.db
APP_ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_WECOM_WEBHOOK_URL=
APP_SCHEDULER_TIMEZONE=Asia/Shanghai
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://192.168.2.148:81

# Zentao browser sync integration
APP_ZENTAO_SYNC_ENABLED=true
APP_ZENTAO_SYNC_API_KEY=change-me
APP_ZENTAO_SYNC_AUTO_MAP_TESTCASE=true
APP_ZENTAO_SYNC_AUTO_APPLY_TESTCASE=false
APP_ZENTAO_SYNC_AUTO_APPLY_BUG=false

# Zentao → n8n AI webhook forwarder
# Access is gated by the "zentao-ai" tab permission (assign via 权限管理 in the admin UI).
# Leave APP_N8N_ZENTAO_AI_WEBHOOK_URL empty to disable the feature server-side.
APP_N8N_ZENTAO_AI_WEBHOOK_URL=
APP_N8N_ZENTAO_AI_WEBHOOK_TOKEN=
# Extra allowlist (CSV usernames). Empty = only tab permission gates access.
APP_ZENTAO_AI_ALLOWED_USERNAMES=
# Rough AI run duration used by the frontend countdown toast (seconds).
APP_ZENTAO_AI_EXPECTED_DURATION_SECONDS=300

# Per-user AI provider (DeepSeek) API Key encryption
# Each user configures their own DeepSeek key in 个人设置 → 🤖 AI密钥;
# it is stored Fernet-encrypted in the user_ai_provider_configs table.
# Key resolution order:
#   1) APP_USER_AI_CONFIG_SECRET (dedicated key, recommended for prod)
#   2) APP_ZENTAO_BINDING_SECRET (reused, convenient)
#   3) SHA-256 of APP_SECRET_KEY  (dev fallback, no extra config needed)
# Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_USER_AI_CONFIG_SECRET=

# 兼容旧变量名（不推荐，建议统一 APP_ 前缀）
# ENV=dev
# SECRET_KEY=replace_with_a_strong_random_secret
# DATABASE_URL=sqlite:///./app_auto.db
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# WECHAT_WEBHOOK_URL=
# SCHEDULER_TIMEZONE=Asia/Shanghai
